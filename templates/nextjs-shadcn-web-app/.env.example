# ===========================================
# 环境变量配置模板
# 使用方法：cp .env.example .env.local
# ===========================================

# 后端 API 地址；留空时请求当前站点的同源相对路径。
# 本地联调后端时，还需在 next.config.ts 配置 rewrites（见 README「环境变量」）。
# NEXT_PUBLIC_ 变量会打包到浏览器，不能存放 Token、密码、API Key 或其他敏感信息。
NEXT_PUBLIC_API_URL=
